#include <iostream>
#include <vector>
#include <string>
using namespace std;

// Class for Book
class Book {
private:
    string title;
    string author;
    bool issued;

public:
    Book(string t, string a) {
        title = t;
        author = a;
        issued = false;
    }

    void showBook() {
        cout << "Title: " << title
             << " | Author: " << author
             << " | Status: " << (issued ? "Issued" : "Available") << endl;
    }

    string getTitle() {
        return title;
    }

    void issueBook() {
        if (issued)
            cout << "Sorry! Book already issued.\n";
        else {
            issued = true;
            cout << "Book issued successfully.\n";
        }
    }

    void returnBook() {
        if (!issued)
            cout << "Book was not issued.\n";
        else {
            issued = false;
            cout << "Book returned successfully.\n";
        }
    }
};

// Class for Library
class Library {
private:
    vector<Book> books;

public:
    Library() {
        // Default books
        books.push_back(Book("Harry Potter and the Sorcerer's Stone", "J.K. Rowling"));
        books.push_back(Book("Story of the Wood Witch's Curse", "Eleanor Blackwood"));
        books.push_back(Book("Sea Quest: Cephalox the Cyber Squid", "Adam Blade"));
    }

    void addBook() {
        string title, author;
        cin.ignore();
        cout << "Enter book title: ";
        getline(cin, title);
        cout << "Enter author name: ";
        getline(cin, author);
        books.push_back(Book(title, author));
        cout << "Book added successfully!\n";
    }

    void showBooks() {
        cout << "\n--- Books in Library ---\n";
        for (auto &b : books)
            b.showBook();
    }

    void issueBook() {
        cin.ignore();
        string title;
        cout << "Enter book title to issue: ";
        getline(cin, title);
        for (auto &b : books) {
            if (b.getTitle() == title) {
                b.issueBook();
                return;
            }
        }
        cout << "Book not found!\n";
    }

    void returnBook() {
        cin.ignore();
        string title;
        cout << "Enter book title to return: ";
        getline(cin, title);
        for (auto &b : books) {
            if (b.getTitle() == title) {
                b.returnBook();
                return;
            }
        }
        cout << "Book not found!\n";
    }
};

// Main Function
int main() {
    Library lib;
    int choice;

    cout << "====== LIBRARY MANAGEMENT SYSTEM ======\n";

    do {
        cout << "\n1. Show all books";
        cout << "\n2. Add new book";
        cout << "\n3. Issue a book";
        cout << "\n4. Return a book";
        cout << "\n0. Exit";
        cout << "\nEnter your choice: ";
        cin >> choice;

        switch (choice) {
            case 1: lib.showBooks(); break;
            case 2: lib.addBook(); break;
            case 3: lib.issueBook(); break;
            case 4: lib.returnBook(); break;
            case 0: cout << "Exiting... Goodbye!\n"; break;
            default: cout << "Invalid choice!\n";
        }
    } while (choice != 0);

    return 0;
}
